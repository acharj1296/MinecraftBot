# Minecraft Bot Configuration
# Copy this file to .env and fill in your values

# ===========================================
# Server Connection (REQUIRED)
# ===========================================
MINECRAFT_HOST=localhost
MINECRAFT_PORT=25565

# ===========================================
# Bot Identity (REQUIRED)
# ===========================================
MINECRAFT_USERNAME=NoxGamer

# ===========================================
# Minecraft Version (REQUIRED)
# Examples: "1.20.4", "1.19.2", "1.18.2", "1.16.5", "latest"
# Use "latest" for auto-detection (may be slower)
# ===========================================
MINECRAFT_VERSION=1.20.4

# ===========================================
# Authentication Mode (REQUIRED)
# Options: "online" (Microsoft auth) or "offline" (cracked/offline servers)
# ===========================================
MINECRAFT_AUTH=offline

# ===========================================
# Optional: Password for offline mode servers
# Only needed if the server requires a password for the username
# ===========================================
MINECRAFT_PASSWORD=

# ===========================================
# Optional: Microsoft Authentication (for online mode only)
# Get these from Microsoft OAuth flow or use a tool like mslogin
# ===========================================
MINECRAFT_MS_AUTH_TOKEN=
MINECRAFT_CLIENT_TOKEN=

# ===========================================
# Optional: Proxy (format: "http://user:pass@host:port" or "socks5://host:port")
# ===========================================
MINECRAFT_PROXY=

# ===========================================
# Optional: Keep Alive Interval (milliseconds)
# Default: 30000 (30 seconds)
# ===========================================
MINECRAFT_KEEP_ALIVE=30000