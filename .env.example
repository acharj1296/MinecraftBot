# Minecraft Server Configuration
# Copy this file to .env and fill in your values

# Server host (IP or domain)
HOST=localhost

# Server port
PORT=25565

# Bot username (for offline mode servers)
# For online mode servers, you'll need a valid Microsoft account
USERNAME=AutoReconnectBot

# Minecraft version (e.g., "1.20.1", "1.19.4", "1.18.2")
# Use "auto" to automatically detect version
VERSION=auto

# Reconnect delay in milliseconds (default: 5000)
RECONNECT_DELAY=5000